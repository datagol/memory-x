# Copy to .env and fill in. docker compose reads this file automatically.

# Required. One OpenRouter key covers all three models: Haiku 5.5 (extraction),
# text-embedding-3-small (neighbors) and Jev (every decision). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Bearer token for the API, the dashboard and the MCP server. Leave empty for no auth (fine while the ports are
# bound to localhost). When set, paste it into the dashboard under Settings and give it to MCP clients as
# "Authorization: Bearer <token>".
MEMX_API_TOKEN=

# Where the API and dashboard are published. The default is this machine only. Use another port if 8000 is
# taken (127.0.0.1:8080), or a bare port (8000) to expose it to your network; set MEMX_API_TOKEN first.
# MEMX_PUBLISH=127.0.0.1:8000
# Where the MCP server is published (clients connect to http://<host:port>/mcp). Same rules as MEMX_PUBLISH.
# MEMX_MCP_PUBLISH=127.0.0.1:8100
# Scope MCP tools use when the client does not name one.
# MEMX_MCP_SCOPE=memory.default
# Host names MCP clients may use to reach the server (DNS-rebinding protection). Add yours when exposing it,
# e.g. memx.internal,memx.internal:*  ('*' turns the check off; only behind a proxy that checks hosts itself).
# MEMX_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,[::1]:*,mcp,mcp:*
# Postgres port on this machine, for the memx CLI and psql.
# MEMX_PG_PORT=5433

# Postgres password. Only applies when the data volume is first created.
# POSTGRES_PASSWORD=memx

# Logs: INFO shows ids, counts, timings and costs, never memory text or secrets; DEBUG adds memory text and
# queries (for local troubleshooting only). Use json for a log collector.
# MEMX_LOG_LEVEL=INFO
# MEMX_LOG_FORMAT=text

# Optional overrides; every setting is listed in the README under Configuration.
# MEMX_EXTRACTOR_MODEL=anthropic/claude-haiku-5.5
# MEMX_JEV_MODEL=jev-1.14
# MEMX_BUDGET_TOKENS=4000
